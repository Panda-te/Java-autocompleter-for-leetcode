{
  "manifest_version": 3,
  "name": "LeetCode Java Autocomplete",
  "version": "1.1.0",
  "description": "Smart Java autocomplete for LeetCode — snippets, variables, keywords, types, methods.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://leetcode.com/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "css": ["autocomplete.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
